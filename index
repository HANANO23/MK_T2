        category: "[분야 5] 거시경제학 및 국제금융",
        question: "Q56. 기업이 제품 가격표나 메뉴판을 교체할 때 발생하는 물리적·행정적 비용을 무엇이라 하는가?",
        options: ["① 구두창 비용", "② 메뉴 비용", "③ 거래 비용", "④ 정보 비용", "⑤ 기회 비용"],
        answer: 2,
        explanation: "[정답] ② 메뉴 비용 (Menu Cost)\n\n해설: 물가 변동 시 가격을 새로 조정하는 데 드는 비용을 의미합니다."
      },
      {
        id: 57,
        category: "[분야 5] 거시경제학 및 국제금융",
        question: "Q57. 국가 간 교역에서 양국의 환율은 각국 통화의 구매력 비율에 의해 결정된다는 이론은?",
        options: ["① 구매력평가설(PPP)", "② 이자율평가설(IRP)", "③ 비교우위론", "④ 절대우위론", "⑤ 필립스 이론"],
        answer: 1,
        explanation: "[정답] ① 구매력평가설 (Purchasing Power Parity)\n\n해설: 일물일가의 법칙을 국가 간으로 확장한 환율 결정 이론입니다."
      },
      {
        id: 58,
        category: "[분야 5] 거시경제학 및 국제금융",
        question: "Q58. 개방경제에서 '자유로운 자본 이동', '독립적인 통화정책', '고정환율제'라는 3가지 정책 목표를 동시에 달성할 수 없다는 정리의 명칭은?",
        options: ["① 삼면등가의 원리", "② 불가능의 삼위일체 (Mundell-Fleming Trilemma)", "③ 틴버겐 정리", "④ 피셔의 삼위일체", "⑤ 깁슨의 역설"],
        answer: 2,
        explanation: "[정답] ② 불가능의 삼위일체\n\n해설: 세 가지 중 최대 두 가지 목표만 동시에 선택할 수 있다는 거시경제학 원리입니다."
      },
      {
        id: 59,
        category: "[분야 5] 거시경제학 및 국제금융",
        question: "Q59. 경제 전체에서 생산, 분배, 지출 측면에서 측정한 명목 GDP의 총량이 결국 모두 같아진다는 원리는?",
        options: ["① 삼면등가의 원리", "② 승수 효과", "③ 피셔 방정식", "④ 세이의 법칙", "⑤ 왈라스 법칙"],
        answer: 1,
        explanation: "[정답] ① 삼면등가의 원리\n\n해설: 생산GDP = 분배GDP = 지출GDP가 항상 성립한다는 법칙입니다."
      },
      {
        id: 60,
        category: "[분야 5] 거시경제학 및 국제금융",
        question: "Q60. 정부가 재정지출을 1단위 늘렸을 때 소득 창출 과정을 거쳐 총수요가 몇 배로 증대되는지 나타내는 효과는?",
        options: ["① 구축 효과", "② 승수 효과", "③ 파급 효과", "④ 낙수 효과", "⑤ 분수 효과"],
        answer: 2,
        explanation: "[정답] ② 승수 효과 (Multiplier Effect)\n\n해설: 한 단위의 지출 증가가 한계소비성향에 따라 소득 증폭을 가져오는 현상입니다."
      },
      {
        id: 61,
        category: "[분야 5] 거시경제학 및 국제금융",
        question: "Q61. 15세 이상 인구가 1,000명, 취업자가 800명일 때 고용률은 얼마인가?",
        options: ["① 60%", "② 70%", "③ 75%", "④ 80%", "⑤ 85%"],
        answer: 4,
        explanation: "[정답] ④ 80%\n\n해설: 고용률 = (취업자 수 / 15세 이상 인구) × 100 = (800 / 1000) × 100 = 80%"
      },
      {
        id: 62,
        category: "[분야 5] 거시경제학 및 국제금융",
        question: "Q62. 명목이자율이 6%이고 물가상승률이 1%일 때 실질이자율을 구하면?",
        options: ["① 3%", "② 4%", "③ 5%", "④ 6%", "⑤ 7%"],
        answer: 3,
        explanation: "[정답] ③ 5%\n\n해설: 실질이자율 = 명목이자율 - 물가상승률 = 6% - 1% = 5%."
      }
    ];

    let currentQuestions = [...originalQuestions];
    let currentIndex = 0;
    let userAnswers = {};
    let isWrongOnlyMode = false;

    function initApp() {
      document.getElementById('totalIndex').innerText = currentQuestions.length;
      renderQuestion();
      renderOMR();
      updateScoreSummary();
    }

    function renderQuestion() {
      if (currentQuestions.length === 0) return;
      const q = currentQuestions[currentIndex];

      document.getElementById('categoryBadge').innerText = q.category;
      document.getElementById('currentIndex').innerText = currentIndex + 1;
      document.getElementById('totalIndex').innerText = currentQuestions.length;

      document.getElementById('questionTitle').innerText = q.question;

      const optionsList = document.getElementById('optionsList');
      optionsList.innerHTML = '';

      const selectedOpt = userAnswers[q.id];

      q.options.forEach((optText, idx) => {
        const optNum = idx + 1;
        const btn = document.createElement('button');
        btn.className = 'option-btn';
        btn.innerText = optText;

        if (selectedOpt !== undefined) {
          if (optNum === q.answer) {
            btn.classList.add('correct');
          } else if (optNum === selectedOpt) {
            btn.classList.add('wrong');
          }
          btn.disabled = true;
        } else {
          btn.onclick = () => selectOption(q.id, optNum);
        }

        optionsList.appendChild(btn);
      });

      const expBox = document.getElementById('explanationBox');
      if (selectedOpt !== undefined) {
        expBox.style.display = 'block';
        expBox.innerText = q.explanation;
      } else {
        expBox.style.display = 'none';
        expBox.innerText = '';
      }

      document.getElementById('prevBtn').disabled = (currentIndex === 0);
      document.getElementById('nextBtn').disabled = (currentIndex === currentQuestions.length - 1);

      updateOMRActive();
    }

    function selectOption(qId, optNum) {
      userAnswers[qId] = optNum;
      renderQuestion();
      renderOMR();
      updateScoreSummary();
    }

    function prevQuestion() {
      if (currentIndex > 0) {
        currentIndex--;
        renderQuestion();
      }
    }

    function nextQuestion() {
      if (currentIndex < currentQuestions.length - 1) {
        currentIndex++;
        renderQuestion();
      }
    }

    function renderOMR() {
      const omrGrid = document.getElementById('omrGrid');
      omrGrid.innerHTML = '';

      currentQuestions.forEach((q, idx) => {
        const item = document.createElement('div');
        item.className = 'omr-item';
        if (idx === currentIndex) item.classList.add('active');

        const userAns = userAnswers[q.id];
        let statusText = '-';
        let statusClass = 'status-none';

        if (userAns !== undefined) {
          if (userAns === q.answer) {
            statusText = '정답';
            statusClass = 'status-correct';
          } else {
            statusText = '오답';
            statusClass = 'status-wrong';
          }
        }

        item.innerHTML = `
          <span>Q${String(q.id).padStart(2, '0')}</span>
          <span class="status-badge ${statusClass}">${statusText}</span>
        `;

        item.onclick = () => {
          currentIndex = idx;
          renderQuestion();
        };

        omrGrid.appendChild(item);
      });
    }

    function updateOMRActive() {
      const items = document.querySelectorAll('.omr-item');
      items.forEach((item, idx) => {
        if (idx === currentIndex) {
          item.classList.add('active');
        } else {
          item.classList.remove('active');
        }
      });
    }

    function updateScoreSummary() {
      let correctCount = 0;

      originalQuestions.forEach(q => {
        if (userAnswers[q.id] !== undefined) {
          if (userAnswers[q.id] === q.answer) correctCount++;
        }
      });

      document.getElementById('scoreSummary').innerText = `맞힘: ${correctCount} / ${originalQuestions.length}`;
    }

    function resetAndShuffle() {
      if (confirm('문제를 초기화하고 순서를 섞으시겠습니까?')) {
        isWrongOnlyMode = false;
        userAnswers = {};
        currentQuestions = [...originalQuestions].sort(() => Math.random() - 0.5);
        currentIndex = 0;
        
        document.getElementById('modeBadge').style.display = 'none';
        document.getElementById('wrongOnlyBtn').style.display = 'inline-block';
        document.getElementById('showAllBtn').style.display = 'none';
        
        initApp();
      }
    }

    function filterWrongQuestions() {
      const wrongList = originalQuestions.filter(q => userAnswers[q.id] !== undefined && userAnswers[q.id] !== q.answer);

      if (wrongList.length === 0) {
        alert('틀린 문제가 없습니다! (풀지 않은 문제가 있거나 모두 정답입니다)');
        return;
      }

      isWrongOnlyMode = true;
      currentQuestions = wrongList;
      currentIndex = 0;

      document.getElementById('modeBadge').innerText = `오답 복습 (${wrongList.length}개)`;
      document.getElementById('modeBadge').style.display = 'inline-block';
      document.getElementById('wrongOnlyBtn').style.display = 'none';
      document.getElementById('showAllBtn').style.display = 'inline-block';

      initApp();
    }

    function showAllQuestions() {
      isWrongOnlyMode = false;
      currentQuestions = [...originalQuestions];
      currentIndex = 0;

      document.getElementById('modeBadge').style.display = 'none';
      document.getElementById('wrongOnlyBtn').style.display = 'inline-block';
      document.getElementById('showAllBtn').style.display = 'none';

      initApp();
    }

    document.addEventListener('keydown', function(e) {
      if (e.code === 'Space' || e.key === ' ') {
        e.preventDefault();
        nextQuestion();
      }
    });

    window.onload = initApp;
  </script>
